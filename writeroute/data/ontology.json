    ]
  ],
  "routeStages": [
    {
      "order": 0,
      "id": "brief",
      "input": "user intent",
      "output": "WritingBrief",
      "failure": "purpose or audience remains undefined"
    },
    {
      "order": 1,
      "id": "evidence-boundary",
      "input": "WritingBrief",
      "output": "EvidenceSet",
      "failure": "prose would require invented support"
    },
    {
      "order": 2,
      "id": "genre-and-rhetoric",
      "input": "brief + text",
      "output": "GenreProfile and required moves",
      "failure": "wrong conventions or missing document job"
    },
    {
      "order": 3,
      "id": "author-mode-draft",
      "input": "brief + evidence + genre",
      "output": "draft",
      "failure": "assistant commentary or template prose enters deliverable"
    },
    {
      "order": 4,
      "id": "draft-evidence-gate",
      "input": "draft + EvidenceSet",
      "output": "evidence-bound candidate or rejection",
      "failure": "unsupported factual anchor or review-level claim enters the draft"
    },
    {
      "order": 5,
      "id": "three-layer-audit",
      "input": "draft",
      "output": "surface, substance and structure findings",
      "failure": "authorship guess substitutes for observable evidence"
    },
    {
      "order": 6,
      "id": "candidate-generation",
      "input": "findings",
      "output": "exact edits and rewrite frames",
      "failure": "single untested rewrite or invented detail"
    },
    {
      "order": 7,
      "id": "integrity-gate",
      "input": "source + candidate",
      "output": "preservation verdict",
      "failure": "facts, force, scope, attribution or identifiers change"
    },
    {
      "order": 8,
      "id": "voice-genre-damage-gate",
      "input": "surviving candidate",
      "output": "ranked accepted candidates",
      "failure": "voice flattening, new defects or genre mismatch"
    },
    {
      "order": 9,
      "id": "release",
      "input": "best candidate",
      "output": "final text + audit trail",
      "failure": "candidate does not materially improve the source"
    }
  ],
  "acceptanceGates": [
    {
      "id": "G0-source-text-no-mutation",
      "hard": true,
      "rule": "When source-text mode is active, return the source byte-for-byte and mark every proposed edit non-applicable."
    },
    {
      "id": "G1-span-minimality",
      "hard": false,
      "rule": "Change only the defect and grammar exposed by the repair."
    },
    {
      "id": "G2-anchor-preservation",
      "hard": true,
      "rule": "Preserve numbers, units, names, dates, citations, quotations, cross-references, code and paths."
    },
    {
      "id": "G3-force-preservation",
      "hard": true,
      "rule": "Preserve modal force, negation, scope, direction and causal strength."
    },
    {
      "id": "G4-attribution-preservation",
      "hard": true,
      "rule": "Do not convert source voice into author voice or vice versa."
    },
    {
      "id": "G5-no-invention",
      "hard": true,
      "rule": "Do not add claims, examples, sources, statistics or judgments absent from the evidence set."
    },
    {
      "id": "G6-no-new-defects",
      "hard": true,
      "rule": "Do not introduce a new hard or review-level finding."
    },
    {
      "id": "G7-net-improvement",
      "hard": true,
      "rule": "Editorial burden must not worsen and the target defect must be removed."
    },
    {
      "id": "G8-voice-distance",
      "hard": false,
      "rule": "Do not materially increase distance from an approved voice profile."
    },
    {
      "id": "G9-clean-no-op",
      "hard": true,
      "rule": "Return clean text byte-for-byte when no accepted edit exists."
    }
  ],

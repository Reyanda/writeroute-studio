{
  "id": "writeroute-ontology-v2",
  "version": "2.0.0",
  "purpose": "Represent the full route from writing brief to accepted prose without making authorship claims.",
  "axioms": [
    "A lower editorial-burden score is not sufficient for acceptance.",
    "Every accepted revision must pass meaning-preservation gates.",
    "A source-reported statement is not automatically the current author's assertion.",
    "A missing fact must remain missing or be requested; it may not be invented for fluency.",
    "Genre conventions can change the severity of a style pattern but cannot override factual integrity.",
    "Clean text must be returned byte-for-byte when no edit clears a net-improvement gate.",
    "When source-text mode is active, diagnosis and suggestions may be emitted but no candidate may mutate the source."
  ],
  "classes": [
    {
      "id": "WritingRoute",
      "definition": "Ordered control process governing drafting, diagnosis, revision and acceptance."
    },
    {
      "id": "WritingBrief",
      "definition": "Purpose, audience, reader action, evidence boundary, constraints and length."
    },
    {
      "id": "EvidenceSet",
      "definition": "Facts, sources, quotations, data and constraints available to the writer."
    },
    {
      "id": "GenreProfile",
      "definition": "Purpose, audience, required rhetorical moves, protected conventions and integrity policy."
    },
    {
      "id": "VoiceProfile",
      "definition": "Approved, measurable habits derived from uncontaminated author samples."
    },
    {
      "id": "Document",
      "definition": "Text plus exact-offset paragraphs, sentences and tokens."
    },
    {
      "id": "ProtectedSpan",
      "definition": "Code, quotation or blockquote excluded from ordinary surface scanning."
    },
    {
      "id": "SourceTextMode",
      "definition": "Read-only route for official, archival, quoted or externally authored text; permits annotation but forbids mutation."
    },
    {
      "id": "ReportedVoiceSpan",
      "definition": "Text attributed to another source and therefore protected from silent authorial rewriting."
    },
    {
      "id": "Finding",
      "definition": "Observable editorial defect or substantive review risk with span, rationale and action."
    },
    {
      "id": "SurfacePattern",
      "definition": "Lexical, rhetorical, formatting or chatbot-residue pattern."
    },
    {
      "id": "SubstanceRisk",
      "definition": "Unsupported causal, safety, novelty, statistical or recommendation claim."
    },
    {
      "id": "StructuralRisk",
      "definition": "Document-shape defect such as uniform rhythm, repeated conclusion or overloaded sentence."
    },
    {
      "id": "CandidateEdit",
      "definition": "Exact span replacement with integrity, damage, burden and voice measurements."
    },
    {
      "id": "RewriteFrame",
      "definition": "Evidence-aware prose frame requiring author input; never auto-applied."
    },
    {
      "id": "DraftEvidenceAnchor",
      "definition": "Quantitative or identity-bearing content in a draft that must be licensed by the supplied brief."
    },
    {
      "id": "IntegrityAnchor",
      "definition": "Number, unit, date, citation, quotation, name, acronym, code identifier, path or cross-reference."
    },
    {
      "id": "SemanticForce",
      "definition": "Negation, quantifier scope, modal force, comparison direction or causal strength."
    },
    {
      "id": "AcceptanceGate",
      "definition": "Deterministic or model-assisted test that a candidate must pass."
    },
    {
      "id": "AuditReport",
      "definition": "Genre-resolved findings, burden, dimensions and document metrics without an authorship label."
    },
    {
      "id": "RevisionContract",
      "definition": "Bounded instructions containing only named defects, invariants and genre rules."
    },
    {
      "id": "EvaluationCase",
      "definition": "Frozen positive, clean protection or preservation test with expected outcomes."
    }
  ],

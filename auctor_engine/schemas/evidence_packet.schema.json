{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auctor.local/schemas/evidence_packet.schema.json",
  "title": "Auctor Evidence Packet",
  "description": "Closed-world evidence supplied to a section drafting request.",
  "type": "object",
  "required": ["section", "objective", "items"],
  "properties": {
    "section": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "default": "scientific peer reviewers"
    },
    "target_journal": {
      "type": "string"
    },
    "allowed_claim_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "descriptive",
          "association",
          "prediction",
          "explanation",
          "mechanism",
          "mediation",
          "causation",
          "recommendation"
        ]
      },
      "default": ["descriptive", "association"]
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": ["id", "content"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "default": "finding"
        },
        "source_key": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "descriptive",
            "association",
            "prediction",
            "explanation",
            "mechanism",
            "mediation",
            "causation",
            "recommendation"
          ],
          "default": "descriptive"
        },
        "immutable": {
          "type": "boolean",
          "default": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}

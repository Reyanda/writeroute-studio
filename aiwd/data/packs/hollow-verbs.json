{
  "pack": "hollow-verbs",
  "version": "1.0.0",
  "description": "Verbs and quantities that carry no work: nominalised verb phrases, copular stand-ins, trailing participles that pretend to explain, and vague quantifiers standing where a number belongs.",
  "baselineNote": "All baselines are default_prior. Calibrate before treating any z-score as a measurement.",
  "features": [
    {
      "id": "SuperficialAnalysisParticiple",
      "family": "PragmaticDepth",
      "kind": "regex_rate",
      "unit": "hits_per_1000_tokens",
      "direction": "high_is_ai",
      "weight": 1.0,
      "baseline": {"mean": 0.4, "sd": 0.7, "source": "default_prior"},
      "pattern": ",\\s+(?:highlight|underscor|underlin|reflect|showcas|demonstrat|emphasis|emphasiz|illustrat|signal|mark|cement|solidif|reinforc)\\w*ing\\b",
      "skill": "no-ai-slop",
      "skillPattern": "Superficial analysis",
      "explanation": "Trailing -ing clause that asserts significance instead of stating a consequence. Replace with what actually follows.",
      "falsifiedBy": "A calibrated baseline showing edited human journalism uses the construction at this rate."
    },
    {
      "id": "FakeStrongVerbRate",
      "family": "LexicalPatterns",
      "kind": "lexicon_density",
      "unit": "hits_per_1000_tokens",
      "direction": "high_is_ai",
      "weight": 0.9,
      "baseline": {"mean": 0.5, "sd": 0.8, "source": "default_prior"},
      "lexicon": ["serves as", "serve as", "stands as", "stand as", "acts as",
                  "act as", "functions as", "function as", "operates as",
                  "plays a role", "plays a key role", "plays a vital role",
                  "plays a crucial role", "represents a", "constitutes a",
                  "emerges as", "positions itself as", "stands at the forefront",
                  "is a testament to", "stands as a testament"],
      "rewrites": {"serves as": ["is"], "functions as": ["is"], "acts as": ["is"]},
      "skill": "no-ai-slop",
      "skillPattern": "Fake-strong verbs",
      "explanation": "Copular padding dressed as a verb. Prefer \"is\" and \"has\" when they are clearer.",
      "falsifiedBy": "A calibrated baseline for legal or specification genres where these are terms of art."
    },
    {
      "id": "NominalisedVerbPhraseRate",
      "family": "LexicalPatterns",
      "kind": "lexicon_density",
      "unit": "hits_per_1000_tokens",
      "direction": "high_is_ai",
      "weight": 0.9,
      "baseline": {"mean": 0.6, "sd": 0.9, "source": "default_prior"},
      "lexicon": ["made a decision", "make a decision", "reach a conclusion",
                  "has the ability to", "have the ability to", "provide support",
                  "provides support", "conduct an analysis", "carry out an analysis",
                  "perform a review", "undertake a review", "give consideration to",
                  "take into consideration", "make an assessment", "provide an overview",
                  "engage in discussion", "place emphasis on", "put in place"],
      "rewrites": {"made a decision": ["decided"], "has the ability to": ["can"],
                   "have the ability to": ["can"], "take into consideration": ["consider"]},
      "skill": "no-ai-slop",
      "skillPattern": "Make verbs do the work",
      "explanation": "A verb turned into a noun and propped up by a weak verb. Use the direct verb.",
      "falsifiedBy": "A calibrated baseline for formal institutional prose where the construction is conventional."
    },
    {
      "id": "VagueQuantifierDensity",
      "family": "PragmaticDepth",
      "kind": "lexicon_density",
      "unit": "hits_per_1000_tokens",
      "direction": "high_is_ai",
      "weight": 0.8,
      "baseline": {"mean": 2.5, "sd": 2.0, "source": "default_prior"},
      "lexicon": ["a number of", "a variety of", "a range of", "a wide range of",
                  "numerous", "various", "several", "many", "countless",
                  "a host of", "a myriad of", "myriad", "significant amounts",
                  "substantial numbers", "a growing number of"],
      "skill": "no-ai-slop",
      "skillPattern": "Be concrete and specific",
      "explanation": "A quantity word standing where a number belongs. Give the number or name the cases.",
      "notEvidenceIn": ["clinical"],
      "falsifiedBy": "A calibrated baseline showing the rate is normal where exact counts are genuinely unavailable."
    },
    {
      "id": "SycophanticOpenerRate",
      "family": "EpistemicStance",
      "kind": "lexicon_density",
      "unit": "hits_per_1000_tokens",
      "direction": "high_is_ai",
      "weight": 1.0,
      "baseline": {"mean": 0.02, "sd": 0.2, "source": "default_prior"},
      "lexicon": ["great question", "excellent question", "that's a great point",
                  "you're absolutely right", "you are absolutely right",
                  "i'd be happy to", "i would be happy to", "certainly!",
                  "absolutely!", "of course!", "happy to help",
                  "let me know if you", "i hope this helps"],
      "skill": "no-ai-slop",
      "skillPattern": "Throat-clearing openers",
      "explanation": "Assistant register leaking into a document. Delete outright.",
      "falsifiedBy": "Nothing; these belong in conversation, never in a written deliverable."
    },
    {
      "id": "SecondPersonCoachingRate",
      "family": "EpistemicStance",
      "kind": "lexicon_density",
      "unit": "hits_per_1000_tokens",
      "direction": "high_is_ai",
      "weight": 0.7,
      "baseline": {"mean": 1.2, "sd": 1.6, "source": "default_prior"},
      "lexicon": ["you can", "you'll want to", "you will want to", "you should",
                  "you might want to", "you need to", "make sure you",
                  "remember to", "don't forget to", "keep in mind that",
                  "it's worth remembering"],
      "skill": "no-ai-slop",
      "skillPattern": "Always show, don't tell the reader what to think",
      "explanation": "Instructional second person in a document that is not a manual.",
      "notEvidenceIn": ["tutorial", "documentation"],
      "falsifiedBy": "A calibrated baseline for how-to and documentation genres, where the register is correct."
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stats-brain.org/schemas/semantic_response.schema.json",
  "title": "STATS-BRAIN guarded semantic response",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "domain", "severity", "epistemic_status", "rationale", "repair"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^SB-SEM-[0-9]{3}$"},
          "title": {"type": "string"},
          "domain": {"type": "string"},
          "severity": {"enum": ["fatal", "critical", "major", "minor", "query", "info"]},
          "epistemic_status": {"enum": ["known_error", "consensus_requirement", "context_dependent", "active_debate", "not_identifiable", "not_assessable", "informational"]},
          "evidence_excerpt": {"type": ["string", "null"]},
          "location": {"type": ["string", "null"]},
          "rationale": {"type": "string"},
          "repair": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "not_assessable": {"type": "array"}
  },
  "additionalProperties": false
}
